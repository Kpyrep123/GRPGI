{
  "patch": "1.0.57",
  "baseVersion": "1.0.56",
  "title": "Campaign Studio persistent view + graph ports + galaxy map LOD",
  "installMode": "overlay",
  "npmRequired": false,
  "features": [
    "Campaign Studio camera/selection persists across realtime world updates",
    "Campaign Studio camera is local UI state and no longer sync-saves",
    "drag-to-connect graph ports on knowledge, plot and condition nodes",
    "inline relation labels in Campaign Studio inspector",
    "galaxy system markers 40 percent larger in Electron and Web",
    "Web galaxy labels fade by zoom like desktop"
  ],
