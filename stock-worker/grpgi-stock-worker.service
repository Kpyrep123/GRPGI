[Unit]
Description=GRPGI stock exchange tick worker
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/grpgi-stock-worker
EnvironmentFile=/etc/grpgi-stock-worker.env
ExecStart=/usr/bin/node /opt/grpgi-stock-worker/worker.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
