sync.grpg-sync.ru {
    reverse_proxy 127.0.0.1:8090
}

app.grpg-sync.ru {
    root * /var/www/grpg-app
    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://sync.grpg-sync.ru; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    }

    # HTML and build metadata must always be revalidated so a deploy appears immediately.
    @html {
        path / /app/ *.html /build-info.json
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # JS/CSS use version query strings in HTML.
    @assets {
        path *.js *.css
    }
    header @assets Cache-Control "public, max-age=3600, must-revalidate"
}
