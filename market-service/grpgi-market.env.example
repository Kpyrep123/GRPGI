MARKET_HOST=127.0.0.1
MARKET_PORT=8091
MARKET_DB=/var/lib/grpgi-market/market.sqlite
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_DB=/opt/pocketbase/pb_data/data.db
MARKET_CAMPAIGN_ID=main
MARKET_TICK_SECONDS=10
MARKET_MAX_CANDLES=360
GRPGI_STOCK_WORKER_TOKEN=replace-with-random-secret

# Fractions: 0.001 = 0.1%. Applied by the server; never trust client rates.
MARKET_TRADE_FEE_RATE=0.001
MARKET_BORROW_DAILY_RATE=0.0003
MARKET_CUSTODY_DAILY_RATE=0.0001
