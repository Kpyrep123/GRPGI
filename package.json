{
  "name": "galactic-rpg-interface",
  "version": "1.0.141",
  "description": "Electron/Web tabletop interface with cloud rich-media authoring and fast in-session player editing",
  "author": "qwq",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "mobile:install": "npm --prefix mobile install",
    "mobile:android:init": "npm --prefix mobile run android:init",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:open:android": "npm --prefix mobile run open:android",
    "mobile:copy": "npm --prefix mobile run copy",
    "release": "electron-builder --win nsis --publish never",
    "release:draft": "electron-builder --win nsis --publish never",
    "release:local": "electron-builder --win nsis --publish never",
    "prestart": "node tools/ensure-electron.cjs",
    "electron:repair": "node tools/ensure-electron.cjs --force",
    "electron:check": "node tools/ensure-electron.cjs"
  },
  "build": {
    "appId": "com.qwq.galacticrpg",
    "productName": "Galactic RPG Interface",
    "asarUnpack": [
      "lua-sandbox-worker.cjs",
      "node_modules/wasmoon/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lua-sandbox-worker.cjs",
      "renderer/**/*",
      "package.json",
      "README.md",
      "SOUND_SETUP.md",
      "POCKETBASE_SETUP.md",
      "SELFHOST_SYNC_SETUP.md",
      "LUA_COMBAT_SCRIPTING.md",
      "COMBAT_RULES_AND_AMMUNITION_1.0.122.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "buildVersion": "1.0.141.0",
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.grpg-sync.ru/downloads",
        "channel": "latest"
      }
    ]
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "wasmoon": "^1.16.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kpyrep123/GRPGI.git"
  },
  "bugs": {
    "url": "https://github.com/Kpyrep123/GRPGI/issues"
  },
  "homepage": "https://github.com/Kpyrep123/GRPGI#readme",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "buildVersion": "1.0.140.0"
}
