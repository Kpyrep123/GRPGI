[Unit]
Description=GRPGI raid scheduler and Lua worker
After=network-online.target pocketbase.service
# Dormant until deliberately re-enabled in a future release.
ConditionPathExists=/etc/grpgi-raids.enabled
[Service]
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/grpgi-raids
EnvironmentFile=/etc/grpgi-raids.env
ExecStart=/usr/bin/node /opt/grpgi-raids/raid-service/worker.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
